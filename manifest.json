{
  "manifest_version": 3,
  "name": "PeopleSoft FA Helper",
  "short_name": "FA Helper",
  "version": "1.0.0",
  "description": "Explain PeopleSoft Financial Aid errors, screens and setup, with answers sourced from PeopleBooks, FSA, COD and eCFR.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open PeopleSoft FA Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
